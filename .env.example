# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys.
# Never commit .env.local or paste these values into chats.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (Project Settings -> API Keys -> Secret keys). Server only: never expose it in the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Best match agent (volunteer dashboard). Without a key, picks come from the built-in rules instead.
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: Claude model for ranking (default claude-haiku-5-5).
MATCHING_MODEL=claude-haiku-5-5
# Optional: trace agent runs in LangSmith while debugging.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxx
