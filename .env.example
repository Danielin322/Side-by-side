# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys.
# Never commit .env.local or paste these values into chats.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (Project Settings -> API Keys -> Secret keys). Server only: never expose it in the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Release-note flags (src/features/releaseFlag, ml/release-flag/README.md). Off unless RELEASE_FLAG_ENABLED=true.
RELEASE_FLAG_ENABLED=false
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional, defaults in src/features/releaseFlag/config.ts:
# RELEASE_FLAG_VECTOR_BUCKET=side-by-side-release-flags
# RELEASE_FLAG_VECTOR_INDEX=notes-cohere-mv3-v1
# RELEASE_FLAG_MODEL=claude-haiku-5-5
# RELEASE_FLAG_TOP_K=4
# RELEASE_FLAG_EFFORT=low
# Only for the ml/release-flag eval scripts, never needed on Vercel:
# LANGSMITH_API_KEY=xxx
